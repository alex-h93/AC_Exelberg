# Local Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Source acquisitions and reproducible large generated products
# Keep provenance/manifests locally; documentation and processing code are tracked.
data/raw/
data/interim/
data/processed/
exports/
build/

# Blender recovery files; editable .blend sources are not ignored here
*.blend1
*.blend2

# Blender scenes (up to ~105 MB each, above GitHub's 100 MB limit; rebuilt by the scripts)
blender/
*.blend

# Third-party tool archives (fetched by scripts/; see their provenance files locally)
tools/vendor/

# Local reference media and personal agent tooling (not distributed)
Screenshot_google_maps.jpg
*.mp4
.pi/

# Editors / OS
.DS_Store
*.swp

# Scripts tied to private reference material (kept locally, not distributed)
scripts/video*.py
